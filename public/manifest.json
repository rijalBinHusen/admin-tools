{
  "manifest_version": 3,
  "name": "Vue Sidepanel Extension",
  "version": "1.0",
  "description": "Sidepanel with Vue",
  "permissions": ["sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
